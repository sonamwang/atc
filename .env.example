# Required for agent enrollment. Set a long random value outside source control.
ATC_BOOTSTRAP_TOKEN=change-me-before-running
# Optional for local development; required to protect operator API reads and renewals in deployment.
# ATC_OPERATOR_TOKEN=change-me-before-running
POSTGRES_PASSWORD=change-me-before-running
ATC_SERVER_ADDRESS=:8080
ATC_LOG_LEVEL=info
ATC_DATABASE_URL=postgres://atc:atc@postgres:5432/atc?sslmode=disable
# Set only for throwaway local testing; state is lost at restart.
# ATC_STORAGE=memory
# Local-development issuer only. Never set in production.
# ATC_DEV_CA_DIR=./dev-ca
# Enterprise HTTPS CSR issuer. Mutually exclusive with ATC_DEV_CA_DIR.
# ATC_ISSUER_URL=https://issuer.example.internal/v1/certificates
# ATC_ISSUER_CA_FILE=/run/secrets/issuer-ca.pem
# ATC_ISSUER_CLIENT_CERT_FILE=/run/secrets/issuer-client-cert.pem
# ATC_ISSUER_CLIENT_KEY_FILE=/run/secrets/issuer-client-key.pem
# Opt-in: create renewal jobs for certificates inside the expiry policy window.
# Requires agents to run with -execute-pending before any automatic deployment occurs.
# ATC_AUTO_RENEW=true
# Certificate expiry-policy windows. They must be positive and ordered.
# ATC_POLICY_CRITICAL_HOURS=24
# ATC_POLICY_HIGH_DAYS=7
# ATC_POLICY_MEDIUM_DAYS=30
# Optional signed HTTPS alert delivery. Configure both values; the secret must
# be at least 32 characters and should be held outside source control.
# ATC_ALERT_WEBHOOK_URL=https://alerts.example.internal/atc
# ATC_ALERT_WEBHOOK_SECRET=change-me-to-a-long-random-value
# Production HTTPS and mutual TLS. Configure all four paths and set true.
# ATC_TLS_CERT_FILE=/run/secrets/atc-server-cert.pem
# ATC_TLS_KEY_FILE=/run/secrets/atc-server-key.pem
# ATC_TLS_CLIENT_CA_FILE=/run/secrets/atc-client-ca.pem
# ATC_REQUIRE_MTLS=true
